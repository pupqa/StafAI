<?xml version="1.0" encoding="utf-8"?><!--
   Правила автобэкапа Android < 12L/13 (для 31+ действует data_extraction_rules).
   Исключаем хранилища с секретами: ключ OpenRouter не должен покидать
   устройство ни в открытом виде (fallback-файл), ни в шифрованном —
   EncryptedSharedPreferences после восстановления на другом устройстве
   всё равно не расшифровывается (мастер-ключ привязан к Keystore).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_api_keys.xml" />
    <exclude domain="sharedpref" path="secure_api_keys_fallback.xml" />
</full-backup-content>
