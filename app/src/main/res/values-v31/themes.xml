<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Настоящий системный SplashScreen API (Android 12+) -->
    <style name="Theme.AutCSV.Splash" parent="Theme.SplashScreen">
        <!-- Теперь берёт реальный AppColors.BackgroundSoft (день/ночь через values-night) -->
        <item name="windowSplashScreenBackground">@color/background_soft</item>

        <!-- Наш бейдж вместо куска фонового изображения -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>

        <!-- Фон под иконкой — тот же, что и общий фон сплэша, чтобы не было рамки -->
        <item name="windowSplashScreenIconBackgroundColor">@color/background_soft</item>

        <!-- Тема, на которую переключаемся сразу после скрытия сплэша -->
        <item name="postSplashScreenTheme">@style/Theme.AutCSV</item>
    </style>
</resources>